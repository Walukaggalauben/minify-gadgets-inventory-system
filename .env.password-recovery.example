# MINIFY GADGETS ERP V2 - password recovery SMTP settings
# Copy these values into the DEPLOYED application's environment/.env.
# Never commit real SMTP credentials.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
SMTP_USE_SSL=false

# 900 seconds = 15 minutes
PASSWORD_RESET_TOKEN_MAX_AGE=900

# Optional: use this when the deployed ERP is behind a proxy/load balancer
# and you want a fixed public URL for reset links.
# PUBLIC_BASE_URL=https://erp.example.com
